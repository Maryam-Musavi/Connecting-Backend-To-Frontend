generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Commercial inquiry submitted from the Contact page form
model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  firm      String
  phone     String
  country   String
  message   String
  lang      String   @default("en")
  createdAt DateTime @default(now())
}