# ============================================================
# Refah Sanat Pardis - Contact Form SMTP Configuration
# ============================================================
# For Gmail: you MUST use an "App Password" (16 chars), NOT your
# regular Google password. Regular passwords will be rejected.
#
# How to create a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required for App Passwords)
#   3. Search "App passwords" in the security panel
#   4. Create a new App Password named "Refah Website"
#   5. Copy the 16-character password below (no spaces needed)
#
# ============================================================

# SMTP server (default: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail account that SENDS the email (your Gmail address)
SMTP_USER=your-email@gmail.com

# Gmail App Password (16 chars, no spaces)
SMTP_PASS=your-16-char-app-password

# Display name shown in the From: header
SMTP_FROM_NAME=Refah Sanat Pardis Web Desk

# Email address that RECEIVES the form submissions
# (usually the same as SMTP_USER, but can be any address)
RECIPIENT_EMAIL=your-email@gmail.com

# Server bind config (don't change unless you know what you're doing)
HOST=0.0.0.0
PORT=8000
